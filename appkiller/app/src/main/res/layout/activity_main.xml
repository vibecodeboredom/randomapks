<?xml version="1.0" encoding="utf-8"?>
<!-- App Killer: check the state, do the setup, then Start overlay.
     Flow: status card (root + draw-over-apps) → setup
     (permissions) → Start overlay (primary) / Stop (secondary). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Ra.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Ra.Text.Tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_tagline" />

        <!-- Status -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_status" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/root_status_text"
                    style="@style/Ra.Text.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/root_checking" />

                <TextView
                    android:id="@+id/overlay_status_text"
                    style="@style/Ra.Text.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/overlay_checking" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Setup -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_setup" />

        <Button
            android:id="@+id/overlay_permission_button"
            style="@style/Ra.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/overlay_permission_button" />

        <Button
            android:id="@+id/usage_access_button"
            style="@style/Ra.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/usage_access_button" />

        <!-- Overlay -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_overlay" />

        <Button
            android:id="@+id/start_button"
            style="@style/Ra.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start_button" />

        <Button
            android:id="@+id/stop_button"
            style="@style/Ra.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stop_button" />

        <TextView
            style="@style/Ra.Text.Note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/note" />

    </LinearLayout>

</ScrollView>
