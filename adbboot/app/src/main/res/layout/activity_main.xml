<?xml version="1.0" encoding="utf-8"?>
<!-- AdbBoot: show the state first, then the one setup action.
     Flow: status card → Enable (primary) → Allow in Shizuku
     (secondary, only when needed) → setup note. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Ra.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Ra.Text.Tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_tagline" />

        <!-- Status -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_status" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/statusText"
                style="@style/Ra.Text.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking…" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Setup -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_setup" />

        <Button
            android:id="@+id/enableButton"
            style="@style/Ra.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/enable_button" />

        <Button
            android:id="@+id/allowShizukuButton"
            style="@style/Ra.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/allow_shizuku"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setupNote"
            style="@style/Ra.Text.Note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_note" />

    </LinearLayout>

</ScrollView>
