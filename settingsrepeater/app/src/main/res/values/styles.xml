<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared RandomApks theme: Material 3 dark, one look across all apps. -->
    <style name="Theme.SettingsRepeater" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ra_primary</item>
        <item name="colorOnPrimary">@color/ra_on_primary</item>
        <item name="colorSecondary">@color/ra_primary_light</item>
        <item name="colorSurface">@color/ra_surface</item>
        <item name="colorOnSurface">@color/ra_text_primary</item>
        <item name="android:colorBackground">@color/ra_background</item>
        <item name="android:windowBackground">@color/ra_background</item>
        <item name="android:textColorPrimary">@color/ra_text_primary</item>
        <item name="android:textColorSecondary">@color/ra_text_secondary</item>
    </style>

    <!-- Parent styles for the dotted Ra.* names (AAPT2 requires
         the intermediate parents to exist). -->
    <style name="Ra" />

    <style name="Ra.Text" parent="Ra" />

    <style name="Ra.Button" parent="Ra" />

    <!-- Primary action: filled blue, 56dp min height (thumb + D-pad friendly). -->
    <style name="Ra.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_on_primary</item>
        <item name="backgroundTint">@color/ra_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Destructive action: filled red, same size as primary. -->
    <style name="Ra.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_on_primary</item>
        <item name="backgroundTint">@color/ra_danger</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Secondary action: outlined, quieter than primary. -->
    <style name="Ra.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ra_primary_light</item>
        <item name="strokeColor">@color/ra_outline</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Tertiary action: tonal fill, for setup steps. -->
    <style name="Ra.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ra_text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Type scale: title > tagline > section label > body. -->
    <style name="Ra.Text.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_text_primary</item>
    </style>

    <style name="Ra.Text.Tagline">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ra_text_secondary</item>
    </style>

    <style name="Ra.Text.SectionLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_primary_light</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Ra.Text.FieldLabel">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ra_text_primary</item>
    </style>

    <style name="Ra.Text.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ra_text_secondary</item>
    </style>

    <style name="Ra.Text.Status">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ra_text_primary</item>
    </style>

    <style name="Ra.Text.Note">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ra_text_secondary</item>
    </style>

    <!-- Outlined text field with floating label. -->
    <style name="Ra.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ra_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/ra_primary_light</item>
        <item name="android:textColorHint">@color/ra_text_hint</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
