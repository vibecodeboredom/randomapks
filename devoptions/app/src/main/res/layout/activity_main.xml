<?xml version="1.0" encoding="utf-8"?>
<!-- DevOptions: tries to open Developer options straight away; this
     screen only shows when they aren't enabled yet.
     Layout: one centered card — what happened, what to do, one big
     primary button. Nothing else to find. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fallbackLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ra_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:contentPadding="24dp"
        app:strokeColor="@color/ra_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Ra.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fallback_title" />

            <TextView
                style="@style/Ra.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fallback_body" />

            <Button
                android:id="@+id/openSettingsButton"
                style="@style/Ra.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/open_settings" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
