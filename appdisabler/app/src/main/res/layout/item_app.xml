<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the App Manager list: name, package, state, switch.
     Tapping the row flips the switch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ra_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/row_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ra_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/row_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/row_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

</LinearLayout>
