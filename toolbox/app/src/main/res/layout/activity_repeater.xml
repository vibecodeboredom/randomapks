<?xml version="1.0" encoding="utf-8"?>
<!-- Settings Repeater: set up the repeat, then Start.
     Flow: 1) how many times + how fast, 2) which page,
     3) options, then status, then the big Start button. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Ra.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sr_app_name" />

        <TextView
            style="@style/Ra.Text.Tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sr_app_tagline" />

        <!-- 1 · Repeat -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sr_section_repeat" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Ra.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sr_times_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/times_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="5"
                        android:textColor="@color/ra_text_primary"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Ra.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/sr_delay_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/delay_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="500"
                        android:textColor="@color/ra_text_primary"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 2 · Page -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sr_section_page" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Ra.Text.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sr_page_label" />

                <Spinner
                    android:id="@+id/page_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ra_input_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/custom_input_layout"
                    style="@style/Ra.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/sr_custom_hint"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/custom_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:textColor="@color/ra_text_primary"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 3 · Options -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sr_section_options" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/random_checkbox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/sr_random_label"
                    android:textColor="@color/ra_text_primary"
                    android:textSize="18sp" />

                <CheckBox
                    android:id="@+id/root_checkbox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/sr_root_label"
                    android:textColor="@color/ra_text_primary"
                    android:textSize="18sp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/status_text"
                style="@style/Ra.Text.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sr_status_ready" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Actions: Start is the primary action, biggest and first. -->
        <Button
            android:id="@+id/start_button"
            style="@style/Ra.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sr_start_button" />

        <Button
            android:id="@+id/stop_button"
            style="@style/Ra.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sr_stop_button" />

        <Button
            android:id="@+id/admin_button"
            style="@style/Ra.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sr_admin_button" />

        <TextView
            style="@style/Ra.Text.Note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sr_note" />

    </LinearLayout>

</ScrollView>
