<?xml version="1.0" encoding="utf-8"?>
<!-- Ringtone Spammer: pick a sound, set the run, Start.
     Flow: 1) sound (picker + current choice), 2) run (count +
     delay), then status, then the big Start button. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Ra.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rs_app_name" />

        <TextView
            style="@style/Ra.Text.Tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/rs_app_tagline" />

        <!-- 1 · Sound -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rs_section_sound" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sound_label"
                    style="@style/Ra.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rs_sound_default_notification" />

                <Button
                    android:id="@+id/pick_sound_button"
                    style="@style/Ra.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/rs_pick_sound" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 2 · Run -->
        <TextView
            style="@style/Ra.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rs_section_run" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Ra.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/rs_count_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/count_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="10"
                        android:textColor="@color/ra_text_primary"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Ra.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/rs_delay_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/delay_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="500"
                        android:textColor="@color/ra_text_primary"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/ra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/ra_outline"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/status_text"
                style="@style/Ra.Text.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rs_status_ready" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Actions: Start is the primary action, biggest and first. -->
        <Button
            android:id="@+id/start_button"
            style="@style/Ra.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rs_start_button" />

        <Button
            android:id="@+id/stop_button"
            style="@style/Ra.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rs_stop_button" />

        <TextView
            style="@style/Ra.Text.Note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rs_note" />

    </LinearLayout>

</ScrollView>
