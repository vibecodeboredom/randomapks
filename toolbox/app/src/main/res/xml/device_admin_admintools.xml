<?xml version="1.0" encoding="utf-8"?>
<!-- Device admin policies for Toolbox (Admin Tools): the ones the app's
     features actually use. There is deliberately no erase/reset
     policy here — the app has no way to erase the device. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <expire-password />
        <encrypted-storage />
        <disable-camera />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
