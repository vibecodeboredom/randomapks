    <string name="keyguard_button">Apply keyguard features</string>

    <string name="encryption_label">Storage encryption</string>
    <string name="encryption_button">Require encryption</string>

    <string name="a11y_label">Permitted accessibility services</string>
    <string name="a11y_hint">Package names, comma-separated</string>
    <string name="a11y_apply_button">Apply restriction</string>
    <string name="a11y_clear_button">Clear restriction</string>

