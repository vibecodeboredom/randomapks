    <string name="status_admin">Device admin active — the buttons below work.</string>
    <string name="admin_button">Enable device admin</string>

    <string name="lock_label">Lock device now</string>
    <string name="lock_button">Lock now</string>

    <string name="password_label">Set lock screen password</string>
    <string name="password_hint">New password</string>
    <string name="password_button">Set password</string>

    <string name="quality_label">Password quality</string>
    <string name="quality_button">Apply quality</string>

    <string name="length_label">Minimum password length</string>
    <string name="length_hint">e.g. 4</string>
    <string name="length_button">Apply length</string>

    <string name="max_lock_label">Maximum time to lock (seconds)</string>
    <string name="max_lock_hint">e.g. 60</string>
    <string name="max_lock_button">Apply</string>

    <string name="expiry_label">Password expiration (days)</string>
    <string name="expiry_hint">e.g. 90 (0 = never)</string>
    <string name="expiry_button">Apply</string>

    <string name="camera_label">Disable camera</string>

    <string name="keyguard_label">Keyguard features to disable</string>
    <string name="keyguard_widgets">Widgets</string>
